# cmd неверно разбирает .bat с переводами строк LF,
# поэтому git всегда хранит и выдаёт их с CRLF.
*.bat text eol=crlf
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
*.docx binary
# Веб-версия: переводы строк LF, шрифты — двоичные файлы.
*.js text eol=lf
*.html text eol=lf
*.css text eol=lf
*.txt text eol=lf
*.ttf binary
